# 홈서버 앞단 리버스 프록시. proxy 이미지(deploy/proxy.Dockerfile)에 들어감
# 인터넷 → Tailscale Funnel(HTTPS) → 호스트 127.0.0.1:8090 → proxy 컨테이너(여기) → web(Next.js) / api(NestJS) 컨테이너
{
	# HTTPS 는 Funnel 이 처리하므로 여기서는 HTTP 만 받음
	auto_https off
	servers {
		# 호스트의 tailscaled 가 붙인 X-Forwarded-For 를 믿음. 컨테이너 안에서는 그 연결이 Docker 게이트웨이(사설 대역)로 보임
		# 포트는 호스트 127.0.0.1 에만 열려 있어 바깥에서 이 경로로 바로 들어올 수 없음
		trusted_proxies static private_ranges
	}
}

http://:8090 {
	encode zstd gzip

	# 접속 로그는 표준 출력으로 남겨 docker logs 와 관리 패널에서 봄 (Authorization, Cookie 헤더는 Caddy 가 기본으로 가림)
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# 페이지. 캐시 헤더는 Next 가 정함 (/_next/static 은 파일 이름에 해시가 붙어 오래 캐시, 페이지는 매번 재검증)
	handle {
		reverse_proxy web:3001
	}
}
