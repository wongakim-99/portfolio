# systemd 사용자 유닛. deploy.sh 가 ~/.config/systemd/user/ 로 복사함
[Unit]
Description=Caddy reverse proxy (portfolio)
After=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/caddy run --config %h/portfolio/Caddyfile --adapter caddyfile
ExecReload=%h/.local/bin/caddy reload --config %h/portfolio/Caddyfile --adapter caddyfile --force
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
