# systemd 사용자 유닛. deploy.sh 가 ~/.config/systemd/user/ 로 복사함
[Unit]
Description=portfolio API (NestJS)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/portfolio/current/apps/api
EnvironmentFile=%h/.config/portfolio/api.env
ExecStart=%h/.local/node/bin/node dist/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
