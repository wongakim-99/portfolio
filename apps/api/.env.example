# 로컬 개발은 npm run dev 가 메모리 Mongo 를 띄우므로 이 파일 없이도 돌아감
# 서버에서는 docker compose 가 ~/.config/portfolio/api.docker.env 를 api 컨테이너에 넣음 (deploy/docker-setup.sh 가 만듦)
PORT=3000
HOST=127.0.0.1
MONGODB_URI=mongodb://portfolio:비밀번호@127.0.0.1:27017/portfolio?authSource=portfolio
ADMIN_TOKEN=24자_이상_임의_문자열
HASH_SALT=임의_문자열
